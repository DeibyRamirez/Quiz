# =============================================================================
# Electro Quiz — variables para Docker Compose
# =============================================================================
#
# Uso:
#   cp .env.docker.example .env.docker
#   # Completar valores (copiar desde .env.local / Firebase Console)
#   docker compose --env-file .env.docker up --build
#
# Producción:
#   docker compose --env-file .env.docker -f docker-compose.prod.yml up --build -d
#
# =============================================================================

APP_PORT=3000

# --- MongoDB ---
# Local (compose con servicio mongo):
MONGODB_URI=mongodb://mongo:27017/Electroquiz
# Producción (Atlas):
# MONGODB_URI=mongodb+srv://USER:PASS@cluster.mongodb.net/Electroquiz

# --- Auth JWT (runtime) ---
JWT_SECRET=cambiar-en-produccion-secreto-largo-y-aleatorio

# --- URLs públicas (build + runtime) ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:3000/api
# NEXT_PUBLIC_SOCKET_URL=

# --- Firebase cliente — Google OAuth (build: inlined en el bundle) ---
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
# Opcionales:
NEXT_PUBLIC_FIREBASE_DATABASE_URL=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# --- IA / Gemini ---
# Vertex AI (preferido: factura GCP por petición). Si VERTEX_PROJECT_ID está definido, se usa Vertex.
VERTEX_PROJECT_ID=
VERTEX_LOCATION=us-central1
# GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"...","private_key":"...","client_email":"..."}

# AI Studio (créditos prepagados; solo si no usas Vertex)
GEMINI_API_KEY=
GEMINI_BASE_URL=
GEMINI_MODEL_FLASH=gemini-3.5-flash-lite
GEMINI_MODEL_PRO=gemini-2.5-pro
GEMINI_TOKEN_UMBRAL_PRO=12000
GEMINI_MAX_UPLOAD_MB=10

# --- Firebase Admin — verificación de token Google (runtime, NO en build) ---
# JSON de la cuenta de servicio en una sola línea (Firebase Console → Project settings → Service accounts)
# FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"...","private_key":"...","client_email":"..."}
